    "@vue/cli-plugin-eslint": "^4.5.0",
    "@vue/cli-service": "^4.5.0",
    "@vue/eslint-config-prettier": "^6.0.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-istanbul": "^7.0.0",
    "check-code-coverage": "^1.10.5",
    "cypress": "^13.14.1",
    "eslint": "^6.7.2",
